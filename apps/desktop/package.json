{
  "name": "@lpp/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/apps/desktop/electron/main.js",
  "scripts": {
    "dev:renderer": "vite --port 5174",
    "dev:main": "tsc -p tsconfig.main.json && tsc-alias -p tsconfig.main.json && concurrently \"tsc -p tsconfig.main.json --watch\" \"tsc-alias -p tsconfig.main.json --watch\"",
    "dev:electron": "wait-on tcp:5174 dist-electron/apps/desktop/electron/main.js && VITE_DEV_SERVER_URL=http://localhost:5174 electron .",
    "dev": "concurrently -k -n RND,MAIN,ELEC -c blue,yellow,green \"pnpm:dev:renderer\" \"pnpm:dev:main\" \"pnpm:dev:electron\"",
    "build": "vite build && tsc -p tsconfig.main.json && tsc-alias -p tsconfig.main.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.main.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@lpp/shared": "workspace:*",
    "@supabase/supabase-js": "^2.106.2",
    "dotenv": "^16.4.5",
    "electron-store": "8.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^45.0.0",
    "eslint": "^9.0.0",
    "nock": "^13.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wait-on": "^8.0.0",
    "tsc-alias": "^1.8.0"
  }
}
